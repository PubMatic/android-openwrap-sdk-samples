<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".OpenWrapSampleApp"
        android:allowBackup="true"
        android:icon="@mipmap/icon_app_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icon_app_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="35">

        <activity
            android:name=".NextGenBannerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="false"
            android:label="@string/title_activity_banner"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".NextGenInterstitialActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="false"
            android:label="@string/title_activity_interstitial"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".NextGenVideoInterstitialActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="false"
            android:label="@string/title_activity_video_interstitial"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".NextGenMRECDisplayActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="false"
            android:label="@string/title_activity_mrec_display"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".NextGenMRECVideoActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="false"
            android:label="@string/title_activity_mrec_video"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="true"
            android:label="@string/title_activity_home"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".NextGenRewardedActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="false"
            android:label="@string/title_activity_rewarded"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".NextGenNativeBannerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="false"
            android:label="@string/title_activity_native_banner"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- GMA Next-Gen fullscreen ad activity: opt out of Android 15 edge-to-edge. -->
        <activity
            android:name="com.google.android.libraries.ads.mobile.sdk.common.AdActivity"
            android:exported="false"
            android:theme="@style/GAMAdActivityTheme"
            tools:replace="android:theme" />
    </application>

</manifest>
