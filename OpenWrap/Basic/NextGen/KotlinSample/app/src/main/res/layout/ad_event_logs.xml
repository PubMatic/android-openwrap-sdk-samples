<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/native_container_height"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="@dimen/top_margin">

    <ScrollView
        android:id="@+id/verticalScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/ad_event_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/pob_dimen_5dp"
            android:hint="@string/ad_event_hint"
            android:inputType="textMultiLine"
            android:maxLines="7000"
            android:lineSpacingExtra="@dimen/pob_dimen_2dp"
            android:scrollbars="vertical"
            android:singleLine="false"
            android:paddingStart="@dimen/pob_dimen_16dp"
            android:paddingEnd="@dimen/pob_dimen_16dp" />
    </ScrollView>
</FrameLayout>