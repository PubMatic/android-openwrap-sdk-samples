<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <include
        layout="@layout/toolbar"
        android:id="@+id/include_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/btns_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_above="@+id/container"
        android:layout_below="@+id/include_toolbar">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_alignParentBottom="true">

            <Button
                android:id="@+id/load_ad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/load_ad"/>
            <Button
                android:id="@+id/render_ad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/render_ad"
                android:enabled="false"/>
        </LinearLayout>

        <include
            android:id="@+id/logs"
            layout="@layout/ad_event_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/actionBarSize"/>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/native_container_height"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
